datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// One finished run. Anonymous: no callsign or other personal data is stored.
model SignalRun {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now()) @map("created_at")
  ending          String
  cause           String?
  durationMs      Int      @map("duration_ms")
  reducedPressure Boolean  @map("reduced_pressure")
  evidenceCount   Int      @map("evidence_count")
  commandsRun     Int      @map("commands_run")
  hintsShown      Int      @map("hints_shown")
  phaseReached    String   @map("phase_reached")
  aiLines         Int      @map("ai_lines")

  @@index([createdAt])
  @@map("signal_runs")
}
