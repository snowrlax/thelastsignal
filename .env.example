# THE LAST SIGNAL — copy to .env.local and fill in. .env.local is never committed.

# Ollama Cloud key for the character dialogue (https://ollama.com/settings/keys).
# Leave empty to play with authored dialogue only: the game is fully completable without it.
OLLAMA_API_KEY=
# Optional overrides (defaults shown).
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_FALLBACK_MODEL=gpt-oss:20b

# Postgres connection string (Supabase session pooler works) for anonymous run stats.
# Leave empty to disable stats; the ending screen simply omits them.
DATABASE_URL=

# DigitalOcean Gradient serverless inference (https://cloud.digitalocean.com/gen-ai → Model access keys).
# Adds the same open Gemma 4 weights on a second provider. Leave empty to skip.
DIGITALOCEAN_INFERENCE_KEY=
# Optional (defaults shown). DIALOGUE_PRIMARY_PROVIDER=digitalocean tries DigitalOcean first.
DIGITALOCEAN_MODEL=gemma-4-31B-it
DIGITALOCEAN_INFERENCE_HOST=https://inference.do-ai.run
DIALOGUE_PRIMARY_PROVIDER=ollama

# Sentry agent tracing for the dialogue pipeline (server only). Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=1
# Attach prompts and lines to spans. They include players' callsigns and replies, so off by default.
SENTRY_RECORD_DIALOGUE=false
# Build-time only, for source map upload (optional).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ElevenLabs voices (https://elevenlabs.io/app/settings/api-keys). Leave empty for a silent,
# text-only M_VEGA: the game behaves exactly as without it. Needs text-to-speech permission.
ELEVENLABS_API_KEY=
# Optional overrides (defaults shown). One voice for both Ines's tapes and M_VEGA: the persona was
# trained on her. The default is "Matilda", an ElevenLabs premade voice (warm, adult, female).
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# Model for M_VEGA's live lines (low latency).
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Model for `npm run voice:render` (pre-rendered tapes; v3 reads audio tags such as [laughs]).
ELEVENLABS_RECORDING_MODEL_ID=eleven_v3
# Signs model-written lines so /api/voice only speaks text the server wrote. Optional: defaults to
# a hash of ELEVENLABS_API_KEY. Set it (e.g. `openssl rand -hex 32`) to rotate tokens independently.
VOICE_SIGNING_SECRET=
# Most lines /api/voice will synthesize per day across all players (cached lines are free).
# Also set a credit quota on the key itself in the ElevenLabs dashboard.
VOICE_DAILY_LINE_LIMIT=1500
